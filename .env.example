# ==============================================================================
# Blood Buddy Environment Configuration Template
# Copy this file to .env or export these variables in your deployment environment.
# ==============================================================================

# Server HTTP Port (default: 8080)
PORT=8080

# Administrator Credentials
# Recommended: Set strong credentials in production
BLOODBUDDY_ADMIN_USER=admin
BLOODBUDDY_ADMIN_PASSWORD=change_this_to_a_secure_password_in_production

# Emergency Prioritization Threshold (hours before deadline considered 'due soon')
BLOODBUDDY_DUE_SOON_HOURS=2
